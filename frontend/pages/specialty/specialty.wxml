<view class="specialty-container">
  <!-- 商品分类（与导游考证页保持一致） -->
  <view class="category-container">
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="category-item {{selectedCategory === item.key ? 'active' : ''}}"
        data-category="{{item.key}}"
        bindtap="selectCategory"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="product-list">
    <view
      class="product-item card-shadow"
      wx:for="{{productList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onProductTap"
    >
      <view class="product-content">
        <image src="{{item.image}}" class="product-image" mode="aspectFill"></image>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc">{{item.desc}}</text>
          <view class="product-footer">
            <text class="product-price">{{item.price}}</text>
            <view class="add-to-cart" catchtap="onAddToCart" data-id="{{item.id}}">
              <text class="cart-plus">+</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{productList.length === 0}}">该分类下暂无商品</view>
  </view>

  <!-- 购物车浮动按钮 -->
  <view class="cart-float-btn" bindtap="goToCart">
    <text class="cart-icon">🛒</text>
    <text class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
  </view>
</view>
