{
  "containerPort": 80,
  "minNum": 0,
  "maxNum": 5,
  "cpu": 0.5,
  "mem": 1,
  "policyType": "cpu",
  "policyThreshold": 60,
  "dockerfilePath": "./Dockerfile",
  "buildDir": "./",
  "envParams": {
    "DATABASE_URL": "mysql+pymysql://<user>:<password>@<host>:3306/<db>?charset=utf8mb4",
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "<change-me>",
    "BACKEND_BASE_URL": "https://<your-backend-domain>",
    "UPLOAD_DIR": "/app/uploads",
    "WX_PAY_MOCK": "1",
    "WX_PAY_APPID": "",
    "WX_PAY_MCHID": "",
    "WX_PAY_APIV3_KEY": "",
    "WX_PAY_CERT_SERIAL_NO": "",
    "WX_PAY_PRIVATE_KEY_PATH": "/app/certs/apiclient_key.pem",
    "WX_PAY_CERT_DIR": "/app/certs",
    "WX_PAY_NOTIFY_URL": ""
  },
  "healthCheckPath": "/_stcore/health"
}