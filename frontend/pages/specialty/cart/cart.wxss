/* 购物车页面样式 */
.cart-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 购物车列表 */
.cart-list {
  padding: 16rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 选择框 */
.checkbox {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.checkbox-inner {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.checkbox-inner.checked {
  background-color: #1677ff;
  border-color: #1677ff;
}

.checkbox-inner.checked::after {
  content: "✓";
  color: #fff;
  font-size: 24rpx;
}

/* 商品信息 */
.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  display: block;
  font-size: 28rpx;
  color: #262626;
  margin-bottom: 20rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  color: #595959;
}

.qty-num {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}

/* 删除按钮 */
.delete-btn {
  padding: 16rpx;
}

.delete-btn text {
  color: #ff4d4f;
  font-size: 26rpx;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8c8c8c;
  margin-bottom: 48rpx;
}

.go-shopping {
  padding: 20rpx 80rpx;
  background-color: #1677ff;
  border-radius: 40rpx;
}

.go-shopping text {
  color: #fff;
  font-size: 28rpx;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.select-all {
  display: flex;
  align-items: center;
}

.select-all text {
  font-size: 28rpx;
  color: #262626;
  margin-left: 8rpx;
}

.total-section {
  flex: 1;
  text-align: right;
  padding-right: 24rpx;
}

.total-label {
  font-size: 28rpx;
  color: #595959;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.checkout-btn {
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  border-radius: 40rpx;
  padding: 16rpx 48rpx;
}

.checkout-btn text {
  color: #fff;
  font-size: 28rpx;
}
