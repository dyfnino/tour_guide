/* 特产与文创（商品列表）页面样式 —— 与导游考证页面保持一致 */
.specialty-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 商品分类 */
.category-container {
  background-color: #fff;
  padding: 24rpx 16rpx;
  margin-bottom: 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  font-size: 24rpx;
  color: #595959;
}

.category-item.active {
  background-color: #1677ff;
  color: #fff;
}

/* 商品列表 */
.product-list {
  padding: 0 16rpx;
  margin-bottom: 180rpx;
}

.product-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.product-content {
  display: flex;
  padding: 24rpx;
}

.product-image {
  width: 192rpx;
  height: 192rpx;
  border-radius: 8rpx;
}

.product-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #262626;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-desc {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.add-to-cart {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(22, 119, 255, 0.1);
  display: flex;
  justify-content: center;
  align-items: center;
}

.cart-plus {
  font-size: 40rpx;
  line-height: 1;
  color: #1677ff;
  font-weight: bold;
}

.empty-tip {
  text-align: center;
  color: #bfbfbf;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 购物车浮动按钮 */
.cart-float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.4);
}

.cart-float-btn .cart-icon {
  font-size: 48rpx;
  color: #fff;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  border-radius: 18rpx;
  padding: 0 8rpx;
}
