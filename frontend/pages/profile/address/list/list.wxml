<view class="addr-container">
  <view wx:if="{{addresses.length === 0 && !loading}}" class="empty">
    <text>暂无收货地址</text>
  </view>

  <view class="addr-list">
    <view class="addr-card" wx:for="{{addresses}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelect">
      <view class="addr-main">
        <view class="addr-header">
          <text class="addr-name">{{item.name}}</text>
          <text class="addr-phone">{{item.phone}}</text>
          <text wx:if="{{item.is_default}}" class="addr-tag">默认</text>
        </view>
        <text class="addr-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
      </view>
      <view class="addr-actions" catchtap="noop">
        <text wx:if="{{!item.is_default}}" class="act" data-id="{{item.id}}" catchtap="onSetDefault">设默认</text>
        <text class="act" data-id="{{item.id}}" catchtap="goEdit">编辑</text>
        <text class="act del" data-id="{{item.id}}" catchtap="onDelete">删除</text>
      </view>
    </view>
  </view>

  <view class="add-btn" bindtap="goAdd">+ 新增收货地址</view>
</view>